#!/usr/bin/env python3
"""
Browser control for QA Agent. Uses Playwright Chromium headless.
Login state persisted via storage_state.

Usage:
  python3 browser.py navigate <url>                  # Go to URL, print page snapshot
  python3 browser.py snapshot                        # Print current page elements
  python3 browser.py screenshot [filename]           # Take screenshot
  python3 browser.py click <selector>                # Click element
  python3 browser.py fill <selector> <text>          # Fill input
  python3 browser.py select <selector> <value>       # Select dropdown
  python3 browser.py press <key>                     # Press key (Enter, Tab, etc)
  python3 browser.py eval <js>                       # Run JavaScript
  python3 browser.py login-ec <email> <password>     # Login to EC site
  python3 browser.py run <script.py>                 # Run a Playwright script

Options:
  --chrome    Use real Chrome profile (inherits Google OAuth login state).
              Chrome must be closed first. Works with all commands.
              Example: python3 browser.py --chrome navigate https://dev-central.yamibuy.tech
"""
import sys, json, os, time

STATE_FILE = "/mnt/d/data/playwright-profile/state.json"
SCREENSHOT_DIR = "/mnt/d/data/playwright-screenshots"
CHROME_USER_DATA = "/mnt/c/Users/17564/AppData/Local/Google/Chrome/User Data"
os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
os.makedirs(SCREENSHOT_DIR, exist_ok=True)

def get_page(use_chrome_profile=False):
    from playwright.sync_api import sync_playwright
    pw = sync_playwright().start()

    if use_chrome_profile:
        # Launch Chromium using the real Chrome profile (inherits all cookies including Google OAuth)
        # NOTE: Chrome must be fully closed first, or use a separate --profile-directory
        ctx = pw.chromium.launch_persistent_context(
            user_data_dir=CHROME_USER_DATA,
            headless=True,
            args=["--no-sandbox", "--profile-directory=Default"],
            viewport={"width": 1280, "height": 800},
            timeout=30000,
        )
        page = ctx.pages[0] if ctx.pages else ctx.new_page()
        return pw, None, ctx, page

    browser = pw.chromium.launch(headless=True, args=["--no-sandbox"])
    ctx_opts = {"viewport": {"width": 1280, "height": 800}}
    if os.path.exists(STATE_FILE):
        ctx_opts["storage_state"] = STATE_FILE
    context = browser.new_context(**ctx_opts)
    page = context.new_page()
    return pw, browser, context, page

def save_state(context):
    try:
        context.storage_state(path=STATE_FILE)
    except:
        pass

def snapshot(page):
    info = page.evaluate("""() => {
        const els = [];
        document.querySelectorAll('a,button,input,select,textarea,[role="button"],[role="link"],[role="tab"],[onclick]').forEach((el, i) => {
            const r = el.getBoundingClientRect();
            if (r.width === 0 && r.height === 0) return;
            els.push({
                i, tag: el.tagName.toLowerCase(), type: el.type||'',
                text: (el.textContent||'').trim().substring(0,80),
                placeholder: el.placeholder||'', name: el.name||'',
                id: el.id||'', value: (el.value||'').substring(0,30),
                href: (el.href||'').substring(0,80)
            });
        });
        const texts = [];
        const w = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        let n; while(n = w.nextNode()) { const t=n.textContent.trim(); if(t.length>2&&t.length<200) texts.push(t); }
        return {els, texts: texts.slice(0,40)};
    }""")
    print(f"URL: {page.url}")
    print(f"Title: {page.title()}")
    print(f"\n=== Elements ({len(info['els'])}) ===")
    for el in info["els"]:
        p = [f"[{el['i']}]", el["tag"]]
        if el["type"]: p.append(f"type={el['type']}")
        if el["id"]: p.append(f"id={el['id']}")
        if el["name"]: p.append(f"name={el['name']}")
        if el["text"]: p.append(f'"{el["text"][:50]}"')
        if el["placeholder"]: p.append(f'ph="{el["placeholder"]}"')
        if el["value"]: p.append(f'val="{el["value"]}"')
        if el["href"]: p.append(f'href={el["href"]}')
        print("  " + " | ".join(p))
    print(f"\n=== Text ({len(info['texts'])}) ===")
    for t in info["texts"]:
        print(f"  {t}")

def main():
    if len(sys.argv) < 2:
        print(__doc__); return

    # Check for --chrome flag (use real Chrome profile with Google login)
    use_chrome = "--chrome" in sys.argv
    if use_chrome:
        sys.argv.remove("--chrome")

    cmd = sys.argv[1]
    pw, browser, ctx, page = get_page(use_chrome_profile=use_chrome)

    try:
        if cmd == "navigate":
            page.goto(sys.argv[2], wait_until="networkidle", timeout=30000)
            save_state(ctx)
            snapshot(page)

        elif cmd == "snapshot":
            # Need a URL from state - navigate to last known page
            print("Note: headless mode restarts browser each time. Use 'navigate' instead.")

        elif cmd == "screenshot":
            page.goto(sys.argv[3] if len(sys.argv) > 3 else "about:blank", wait_until="networkidle", timeout=30000)
            fname = sys.argv[2] if len(sys.argv) > 2 else f"shot_{int(time.time())}.png"
            if not fname.endswith(".png"): fname += ".png"
            path = os.path.join(SCREENSHOT_DIR, fname)
            page.screenshot(path=path, full_page=True)
            print(f"Saved: {path}")

        elif cmd == "click":
            url = sys.argv[3] if len(sys.argv) > 3 else None
            if url: page.goto(url, wait_until="networkidle", timeout=30000)
            page.click(sys.argv[2], timeout=10000)
            page.wait_for_load_state("networkidle", timeout=10000)
            save_state(ctx)
            snapshot(page)

        elif cmd == "fill":
            url = sys.argv[4] if len(sys.argv) > 4 else None
            if url: page.goto(url, wait_until="networkidle", timeout=30000)
            page.fill(sys.argv[2], sys.argv[3], timeout=10000)
            save_state(ctx)
            print(f"Filled {sys.argv[2]} with '{sys.argv[3]}'")

        elif cmd == "select":
            url = sys.argv[4] if len(sys.argv) > 4 else None
            if url: page.goto(url, wait_until="networkidle", timeout=30000)
            page.select_option(sys.argv[2], sys.argv[3], timeout=10000)
            save_state(ctx)
            print(f"Selected {sys.argv[3]} in {sys.argv[2]}")

        elif cmd == "press":
            page.keyboard.press(sys.argv[2])
            print(f"Pressed {sys.argv[2]}")

        elif cmd == "eval":
            url = sys.argv[3] if len(sys.argv) > 3 else None
            if url: page.goto(url, wait_until="networkidle", timeout=30000)
            result = page.evaluate(sys.argv[2])
            print(json.dumps(result, default=str, ensure_ascii=False, indent=2))

        elif cmd == "login-ec":
            email, password = sys.argv[2], sys.argv[3]
            env = sys.argv[4] if len(sys.argv) > 4 else "dev"
            base_urls = {
                "dev": "https://dev-customer.yamibuy.tech",
                "gqc": "https://gqc-customer.yamibuy.tech",
                "uat": "https://uat-customer.yamibuy.tech",
            }
            base = base_urls.get(env, base_urls["dev"])
            page.goto(f"{base}/zh/account/login", wait_until="networkidle", timeout=30000)
            # Step 1: Enter email
            page.fill('#data-qa-header-login-email-input, input[name="username"]', email, timeout=10000)
            page.click('button:has-text("继续"), button:has-text("Continue")', timeout=10000)
            page.wait_for_load_state("networkidle", timeout=10000)
            # Step 2: Enter password (appears after clicking continue)
            page.fill('input[type="password"]', password, timeout=10000)
            page.click('button:has-text("登录"), button:has-text("Log In"), button[type="submit"]', timeout=10000)
            page.wait_for_load_state("networkidle", timeout=15000)
            save_state(ctx)
            print(f"Login result - URL: {page.url}")
            print(f"Title: {page.title()}")

        elif cmd == "test":
            # Run a multi-step test: navigate + actions + verify
            # Usage: browser.py test <url> <test_script.json>
            url = sys.argv[2]
            page.goto(url, wait_until="networkidle", timeout=30000)
            steps = json.loads(open(sys.argv[3]).read())
            for i, step in enumerate(steps):
                action = step["action"]
                if action == "click":
                    page.click(step["selector"], timeout=10000)
                elif action == "fill":
                    page.fill(step["selector"], step["value"], timeout=10000)
                elif action == "select":
                    page.select_option(step["selector"], step["value"], timeout=10000)
                elif action == "wait":
                    page.wait_for_timeout(step.get("ms", 1000))
                elif action == "screenshot":
                    path = os.path.join(SCREENSHOT_DIR, step.get("name", f"step_{i}.png"))
                    page.screenshot(path=path, full_page=True)
                elif action == "assert_text":
                    text = page.text_content(step["selector"])
                    assert step["expected"] in text, f"Step {i}: expected '{step['expected']}' in '{text}'"
                elif action == "assert_url":
                    assert step["expected"] in page.url, f"Step {i}: expected '{step['expected']}' in URL '{page.url}'"
                page.wait_for_load_state("networkidle", timeout=10000)
                print(f"Step {i+1}/{len(steps)}: {action} ✓")
            save_state(ctx)
            print("All steps passed ✅")

        elif cmd == "run":
            import subprocess
            r = subprocess.run(["python3", sys.argv[2]], capture_output=True, text=True, timeout=120)
            print(r.stdout)
            if r.stderr: print("STDERR:", r.stderr, file=sys.stderr)
            sys.exit(r.returncode)

        else:
            print(__doc__)

    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        # Take error screenshot
        try:
            page.screenshot(path=os.path.join(SCREENSHOT_DIR, "error.png"), full_page=True)
            print(f"Error screenshot: {SCREENSHOT_DIR}/error.png")
        except: pass
        sys.exit(1)
    finally:
        if browser:
            browser.close()
        else:
            ctx.close()
        pw.stop()

if __name__ == "__main__":
    main()
