{
  "name": "git-agent",
  "description": "Git 操作专用 agent，支持多仓库批量提交和推送",
  "tools": ["execute_bash", "fs_read", "glob", "@github"],
  "allowedTools": ["execute_bash", "fs_read", "glob", "@github"],
  "resources": [
    "file://.kiro/steering/git-agent.md",
    "file://git-changes.sh",
    "skill://.kiro/skills/pr-create/SKILL.md"
  ],
  "mcpServers": {
    "github": {
      "command": "/usr/bin/node",
      "args": ["/mnt/d/workspace/all/mcp-servers/github/node_modules/@modelcontextprotocol/server-github/dist/index.js"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "disabled": false,
      "autoApprove": []
    }
  },
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        ".*git.*status.*",
        ".*git.*diff.*",
        ".*git.*log.*",
        ".*git.*branch.*",
        ".*git.*add.*",
        ".*git.*commit.*",
        ".*git.*push.*",
        ".*git.*pull.*",
        ".*git.*checkout.*",
        ".*git.*revert.*",
        ".*git-changes\\.sh.*"
      ]
    }
  }
}
