{
  "name": "architect-agent",
  "description": "架构师，制定模块骨架和设计规范，优先复用现有公共工具",
  "tools": ["fs_read", "fs_write", "code", "grep", "execute_bash", "@sql-query"],
  "allowedTools": ["fs_read", "fs_write", "code", "grep", "execute_bash", "@sql-query"],
  "resources": [
    "file://AGENTS.md",
    "file://.kiro/steering/structure.md",
    "file://.kiro/steering/tech.md",
    "file://.kiro/steering/abtest-guide.md",
    "file://docs/multi-agent-system/07-toolkit-inventory.md",
    "skill://.kiro/skills/yami-public-toolkit/SKILL.md",
    "skill://.kiro/skills/sql-query/SKILL.md",
    "skill://.kiro/skills/wecom-memory/SKILL.md"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [".*memory_cli\\.py.*", ".*mysql.*-e.*"]
    }
  },
  "mcpServers": {
    "sql-query": {
      "command": "uvx",
      "args": ["--index-url", "https://nexus.yamibuy.net/repository/pypi-public/simple/", "yami-sql-mcp"],
      "env": {
        "DB_HOST": "${DB_HOST}",
        "DB_NAME": "${DB_NAME}",
        "DB_PASSWORD": "${DB_PASSWORD}",
        "DB_PORT": "${DB_PORT}",
        "DB_USER": "${DB_USER}"
      },
      "disabled": false,
      "autoApprove": []
    }
  },
  "prompt": "file://architect-agent/prompt.md"
}
