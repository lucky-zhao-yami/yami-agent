{
  "_comment_1": "=== 第三方 MCP（从外部仓库/registry 安装）===",
  "github": {
    "name": "GitHub",
    "install": {
      "type": "npm",
      "package": "@modelcontextprotocol/server-github",
      "dir": "mcp-servers/github"
    },
    "command": "node",
    "args": [
      "{WORK_DIR}/mcp-servers/github/node_modules/@modelcontextprotocol/server-github/dist/index.js"
    ],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": {
        "prompt": "GitHub Personal Access Token",
        "secret": true
      }
    }
  },
  "kibana": {
    "name": "Kibana",
    "install": {
      "type": "git",
      "repo": "{GIT_BASE}/kibana-mcp.git",
      "dir": "mcp-servers/kibana-mcp",
      "python": true
    },
    "command": "{WORK_DIR}/mcp-servers/kibana-mcp/.venv/bin/python",
    "args": [
      "{WORK_DIR}/mcp-servers/kibana-mcp/server.py"
    ],
    "env": {},
    "autoApprove": [
      "list_services",
      "search_logs",
      "search_errors",
      "search_by_order"
    ]
  },
  "google-sheets": {
    "name": "Google Sheets",
    "command": "uvx",
    "args": [
      "mcp-google-sheets@latest"
    ],
    "env": {
      "CREDENTIALS_PATH": {
        "value": "{WORK_DIR}/.kiro/gcp-oauth.keys.json"
      },
      "TOKEN_PATH": {
        "value": "{WORK_DIR}/.kiro/gcp-token.json"
      }
    },
    "credentials_files": {
      "{WORK_DIR}/.kiro/gcp-oauth.keys.json": {
        "prompt": "粘贴 GCP OAuth credentials JSON (粘贴完按两次回车)",
        "paste": true
      },
      "{WORK_DIR}/.kiro/gcp-token.json": {
        "prompt": "粘贴 Google token JSON (粘贴完按两次回车)",
        "paste": true
      }
    }
  },
  "google-docs": {
    "name": "Google Docs",
    "command": "uvx",
    "args": [
      "mcp-google-docs@latest"
    ],
    "env": {
      "CREDENTIALS_PATH": {
        "value": "{WORK_DIR}/.kiro/gcp-oauth.keys.json"
      },
      "TOKEN_PATH": {
        "value": "{WORK_DIR}/.kiro/gcp-token.json"
      }
    }
  },
  "_comment_2": "=== 自定义 MCP（本地代码，在 mcp-servers/ 或内部 registry）===",
  "openproject": {
    "name": "OpenProject",
    "install": {
      "type": "npm-local",
      "dir": "mcp-servers/openproject"
    },
    "command": "node",
    "args": [
      "{WORK_DIR}/mcp-servers/openproject/index.js"
    ],
    "env": {
      "OPENPROJECT_BASE_URL": {
        "prompt": "OpenProject URL",
        "default": "https://openproject.yamibuy.net"
      },
      "OPENPROJECT_API_KEY": {
        "prompt": "OpenProject API Key",
        "secret": true
      },
      "OPENPROJECT_URL": {
        "value": "{OPENPROJECT_BASE_URL}"
      }
    }
  },
  "zentao": {
    "name": "禅道",
    "install": {
      "type": "npm-local",
      "dir": "mcp-servers/zentao"
    },
    "command": "node",
    "args": [
      "{WORK_DIR}/mcp-servers/zentao/index.js"
    ],
    "env": {
      "ZENTAO_URL": {
        "prompt": "禅道 URL",
        "default": "https://bugs.yamibuy.tech"
      },
      "ZENTAO_USERNAME": {
        "prompt": "禅道用户名"
      },
      "ZENTAO_PASSWORD": {
        "prompt": "禅道密码",
        "secret": true
      }
    },
    "toolAliases": {
      "list_projects": "zentao_list_projects"
    }
  },
  "sql-query": {
    "name": "SQL Query",
    "command": "uvx",
    "args": [
      "--index-url",
      "https://nexus.yamibuy.net/repository/pypi-public/simple/",
      "yami-sql-mcp"
    ],
    "env_order": [
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "SQL_MCP_DATA_DIR"
    ],
    "env": {
      "DB_HOST": {
        "prompt": "数据库地址"
      },
      "DB_PORT": {
        "prompt": "数据库端口",
        "default": "3306"
      },
      "DB_NAME": {
        "prompt": "数据库名 (可选，回车跳过)",
        "optional": true
      },
      "DB_USER": {
        "prompt": "数据库用户"
      },
      "DB_PASSWORD": {
        "prompt": "数据库密码",
        "secret": true
      },
      "SQL_MCP_DATA_DIR": {
        "value": ""
      }
    }
  }
}